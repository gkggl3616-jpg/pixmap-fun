5);border-color:#ff6e78}}
</style></head><body>
<div id="splash" class="splash"><div class="sbox"><div class="sflag">🇹🇷</div><div class="stitle">PIXMAP STUDIO MOBILE V9</div><div style="color:#93a3b5;font-size:12px;margin-top:6px">Kaynaklar hazırlanıyor…</div><div id="checks" class="checks"></div><div class="sprogress"><i id="sbar"></i></div><div class="credit">re designed by frizz2025</div></div></div>
<header><div class="brand"><svg class="logo" viewBox="0 0 180 100"><path fill="#e30a17" d="M4 15 Q45 4 90 13 T176 11 L176 83 Q135 94 90 84 T4 88Z"/><circle cx="73" cy="50" r="25" fill="white"/><circle cx="84" cy="50" r="20" fill="#e30a17"/><polygon fill="white" points="113,50 127,54 117,64 118,78 106,70 93,76 97,62 87,52 101,51 108,38"/></svg><div><h1>Pixmap Studio<br>Mobile V9</h1><small>TIMELAPSE • TÜRKİYE</small></div><div id="dot" class="topdot"></div></div></header>
<main><div id="install" class="installBanner"><span>📲 Pixmap Studio'yu ana ekrana kur</span><button id="installBtn">Kur</button></div>
<section id="p-home" class="page active"><div class="card"><div class="fabric"></div><h3>Tuval ve Koordinatlar</h3><label>Tuval</label><select id="canvas"></select><div class="grid2" style="margin-top:9px"><div><label>Başlangıç</label><input id="start" value="-200_-200" placeholder="#d,5621,-7544,40"></div><div><label>Bitiş</label><input id="end" value="200_200" placeholder="#d,8690,-7340,40"></div></div><div class="hint">Oyundan <b>#d,5621,-7544,40</b> yapıştır; otomatik <b>5621_-7544</b> olur.</div><div class="row" style="margin-top:9px"><button onclick="pasteCoord('start')">📋 Başlangıç</button><button onclick="pasteCoord('end')">📋 Bitiş</button></div><div class="row" style="margin-top:8px"><button class="primary" onclick="previewArea()">🔍 Önizle</button><button onclick="downloadSnapshot()">⬇ PNG</button></div></div><div class="card"><h3>Alan Önizlemesi</h3><div id="preview" class="preview"><span style="color:#667789">Önizleme bekleniyor</span></div></div></section>
<section id="p-time" class="page"><div class="card" id="timeCard"><h3>🎬 Timelapse</h3><div class="grid2"><div><label>Başlangıç tarihi</label><input type="date" id="sd"></div><div><label>Bitiş tarihi</label><input type="date" id="ed"></div></div><div class="rbtns"><button onclick="datePreset(1)">Bugün</button><button onclick="datePreset(3)">3 Gün</button><button onclick="datePreset(7)">7 Gün</button><button onclick="datePreset(30)">30 Gün</button></div><div class="grid2" style="margin-top:9px"><div><label>Kare atlama</label><input id="skip" type="number" min="1" value="1"></div><div><label>Biçim</label><select id="fmt"><option value="mp4">MP4</option><option value="webm">WebM VP9</option><option value="webm lossless">WebM Lossless</option><option value="gif">GIF</option></select></div></div><div class="grid3" style="margin-top:9px"><div><label>FPS</label><input id="fps" type="number" value="30"></div><div><label>Ölçek</label><select id="scale"><option>1</option><option>2</option><option>3</option><option>4</option></select></div><div><label>Hız</label><select id="speed"><option value="0.5">0.5x</option><option value="1" selected>1x</option><option value="2">2x</option><option value="4">4x</option></select></div></div><div class="grid2" style="margin-top:9px"><div><label>Hedef süre (sn)</label><input id="target" type="number" value="0"></div><div><label>Kalite</label><select id="quality"><option>Hızlı</option><option selected>Dengeli</option><option>Yüksek</option><option>Arşiv</option></select></div></div><div class="grid2" style="margin-top:9px"><div><label>Çözünürlük sınırı</label><select id="limit"><option>1080p</option><option>1440p</option><option selected>4K</option><option>Sınır yok</option></select></div><div class="switchline"><label style="margin:0">MP4 Uyumluluk</label><input type="checkbox" id="compat" checked></div></div><div class="switchline" style="margin-top:9px"><label style="margin:0">Kaldığın yerden devam et</label><input type="checkbox" id="resume" checked></div><div id="preflight" class="hint">Çıktı ön kontrolü hazırlanıyor…</div><button class="danger" style="width:100%;margin-top:11px" onclick="startTimelapse()">🎬 TIMELAPSE İNDİR VE VİDEOLAŞTIR</button><button style="width:100%;margin-top:7px" onclick="cancelJob()">⏹ İptal</button></div></section>
<section id="p-frames" class="page"><div class="card"><h3>🎞 Kare Stüdyosu</h3><div class="metric"><div><strong id="fcount">0</strong><span>SAĞLAM</span></div><div><strong id="fmiss">0</strong><span>EKSİK</span></div><div><strong id="fbad">0</strong><span>BOZUK</span></div></div><div class="grid2" style="margin-top:10px"><div><label>Başlangıç</label><input id="rs" type="number" value="1"></div><div><label>Bitiş</label><input id="re" type="number" value="1"></div></div><div class="rbtns"><button onclick="rangePreset('a')">1–100</button><button onclick="rangePreset('b')">101–200</button><button onclick="rangePreset('last')">Son 100</button><button onclick="rangePreset('all')">Tümü</button></div><label style="margin-top:10px">Kare önizleme</label><input class="slider" id="slider" type="range" min="1" max="1" value="1"><div class="rangeRead"><span id="sliderN">t1.png</span><span><button style="height:28px;font-size:10px" onclick="setRangeFromSlider('s')">Başlangıç</button> <button style="height:28px;font-size:10px" onclick="setRangeFromSlider('e')">Bitiş</button></span></div><div id="framePreview" class="preview rangeimage" style="margin-top:8px"><span style="color:#667789">Kare seç</span></div><div class="row" style="margin-top:9px"><button onclick="previewVideo()">▶ Düşük Kalite Önizleme</button><button class="primary" onclick="compileFrames()">🎞 Videolaştır</button></div><button class="danger" style="width:100%;margin-top:7px" onclick="cleanupFrames()">🗑 Seçili PNG Karelerini Temizle</button></div></section>
<section id="p-status" class="page"><div class="card" id="statusCard"><h3>İşlem Durumu</h3><div id="jstatus" style="font-weight:850;margin-bottom:9px">Hazır</div><div class="progress"><i id="bar"></i></div><div class="statusline" style="margin-top:9px"><span id="api" class="pill">API •</span><span id="ff" class="pill">FFmpeg •</span><span id="framesPill" class="pill">0 kare</span></div><div id="latest" style="margin-top:10px"></div></div><div class="card"><h3>Log</h3><div id="logs" class="logs">Hazır.</div><a class="btn" style="margin-top:8px" id="logdl" href="#">💾 Logu Dışa Aktar</a></div><div class="card"><h3>Çıktılar</h3><div id="outputs" class="outlist"></div></div></section>
<section id="p-settings" class="page"><div class="card"><h3>⚙ Görünüm ve Uygulama</h3><label>Efekt yoğunluğu</label><select id="effects"><option>Kapalı</option><option>Hafif</option><option selected>Normal</option><option>Güçlü</option></select><div class="switchline" style="margin-top:12px"><label style="margin:0">Sade mod</label><input type="checkbox" id="simple"></div><button style="width:100%;margin-top:10px" onclick="saveAppearance()">Kaydet</button><div clas