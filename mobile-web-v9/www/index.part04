r').oninput=()=>{$('sliderN').textContent=`t${$('slider').value}.png`;clearTimeout(slidTimer);slidTimer=setTimeout(()=>loadFrame($('slider').value),120)};function frameOpts(){return {...opts(),start_frame:+$('rs').value,end_frame:+$('re').value}}async function compileFrames(){await api('/api/compile',{method:'POST',body:JSON.stringify(frameOpts())});document.querySelector('[data-p=status]').click()}async function previewVideo(){let d=frameOpts();d.format='mp4';await api('/api/preview-video',{method:'POST',body:JSON.stringify(d)});document.querySelector('[data-p=status]').click()}async function cleanupFrames(){if(!confirm('Seçili PNG kareleri silinsin mi?'))return;let r=await api('/api/cleanup',{method:'POST',body:JSON.stringify({start:+$('rs').value,end:+$('re').value})});alert((await r.json()).deleted+' kare silindi.')}
async function poll(){try{let r=await api('/api/status'),d=await r.json();STATE=d;let j=d.job||{},f=d.frames||{};$('jstatus').textContent=j.status||'Hazır';$('bar').style.width=(j.progress||0)+'%';$('logs').textContent=(j.logs||[]).join('\n')||'Hazır.';$('logs').scrollTop=$('logs').scrollHeight;$('fcount').textContent=f.count||0;$('fmiss').textContent=(f.missing||[]).length;$('fbad').textContent=(f.corrupt||[]).length;$('framesPill').textContent=(f.count||0)+' kare';if(f.max){$('slider').min=f.min;$('slider').max=f.max;if(!$('slider').dataset.init){$('slider').value=f.min;$('rs').value=f.min;$('re').value=f.max;$('slider').dataset.init='1';loadFrame(f.min)}}$('logdl').href='/api/log.txt?sid='+encodeURIComponent(SID);if(j.output){$('latest').innerHTML=`<a class="btn success" href="/download/${encodeURIComponent(j.output)}?sid=${encodeURIComponent(SID)}">⬇ ${j.output}</a>`}let sc=$('statusCard');if(j.ok===true&&!sc.dataset.ok){sc.classList.add('flash-ok');setTimeout(()=>sc.classList.remove('flash-ok'),900);sc.dataset.ok='1'}if(j.ok===false&&!sc.dataset.bad){sc.classList.add('flash-bad');setTimeout(()=>sc.classList.remove('flash-bad'),900);sc.dataset.bad='1'}loadOutputs()}catch(e){}}
let outTick=0;async function loadOutputs(){if(++outTick%4)return;try{let r=await api('/api/outputs'),d=await r.json();$('outputs').innerHTML=(d.files||[]).slice(0,10).map(x=>`<div class="outitem"><a href="/download/${encodeURIComponent(x.name)}?sid=${encodeURIComponent(SID)}">⬇ ${x.name}</a><div class="hint">${(x.size/1048576).toFixed(1)} MB</div></div>`).join('')||'<div class="hint">Henüz çıktı yok.</div>'}catch(e){}}setInterval(poll,1100);window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();installPrompt=e;$('install').classList.add('show')});$('installBtn').onclick=async()=>{if(installPrompt){installPrompt.prompt();await installPrompt.userChoice;installPrompt=null;$('install').classList.remove('show')}};if('serviceWorker'in navigator)navigator.serviceWorker.register('/sw.js');boot();setTimeout(updatePreflight,17000);
</script></body></html>
