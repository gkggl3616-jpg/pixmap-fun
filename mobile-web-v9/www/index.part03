s="hint">Mobil sürümde masaüstü imleç efekti yerine dokunma/aktif buton parlaması kullanılır. “Masaüstüne Ekle” yerine PWA kurulumu vardır.</div></div><div class="card"><h3>V9 Mobil Durumu</h3><div class="hint">Tuval API, canlı chunk, history snapshot/chunk, FFmpeg, kare doğrulama ve MP4 uyumluluk sistemi sunucu tarafında çalışır. Telefon yalnızca arayüzü kullanır; site Railway gibi bir sunucuya kurulursa PC açık kalmaz.</div></div></section>
</main><nav class="tabs"><button class="tab active" data-p="home"><b>⌂</b>Ana</button><button class="tab" data-p="time"><b>◫</b>Timelapse</button><button class="tab" data-p="frames"><b>▦</b>Kareler</button><button class="tab" data-p="status"><b>●</b>Durum</button><button class="tab" data-p="settings"><b>⚙</b>Ayarlar</button></nav>
<script>
const $=x=>document.getElementById(x);let SID=localStorage.pixmapSid||(localStorage.pixmapSid=crypto.randomUUID());let PIN=localStorage.pixmapPin||'';let BOOT=null,STATE=null,installPrompt=null;const H={'Content-Type':'application/json','X-Session-Id':SID};function headers(){let h={...H};if(PIN)h['X-App-Pin']=PIN;return h}async function api(url,opt={}){opt.headers={...headers(),...(opt.headers||{})};let r=await fetch(url,opt);if(r.status===401){let p=prompt('Site PIN kodu:');if(p!==null){PIN=p;localStorage.pixmapPin=p;return api(url,opt)}}if(!r.ok){let t=await r.text();try{t=JSON.parse(t).error}catch(e){}throw Error(t||r.statusText)}return r}document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));b.classList.add('active');$('p-'+b.dataset.p).classList.add('active')});function iso(d){return d.toISOString().slice(0,10)}let now=new Date();$('sd').value=iso(now);$('ed').value=iso(now);function datePreset(days){let e=new Date(),s=new Date();s.setDate(e.getDate()-days+1);$('sd').value=iso(s);$('ed').value=iso(e)}
async function boot(){let started=Date.now();let r=await api('/api/boot-check');let d=await r.json();$('checks').innerHTML=d.checks.map(x=>`<div class="check ${x.ok?'ok':'bad'}">${x.ok?'✓':'!'} ${x.name}<small style="display:block;color:#758699;margin-top:2px">${x.detail}</small></div>`).join('');let dur=16000;let timer=setInterval(()=>{let p=Math.min(100,((Date.now()-started)/dur)*100);$('sbar').style.width=p+'%';if(p>=100){clearInterval(timer);$('splash').classList.add('hide');setTimeout(()=>$('splash').remove(),800)}},100);await bootstrap();await loadSettings();}
async function bootstrap(){let r=await api('/api/bootstrap');BOOT=await r.json();$('canvas').innerHTML='';Object.entries(BOOT.canvases||{}).forEach(([id,c])=>{let o=document.createElement('option');o.value=id;o.textContent=id+' - '+(c.name||('Canvas '+id));$('canvas').appendChild(o)});$('dot').style.background=BOOT.canvas_error?'#f05b66':'#48d477';$('api').textContent='API • '+(BOOT.canvas_error?'HATA':'HAZIR');$('ff').textContent='FFmpeg • '+(BOOT.ffmpeg?'HAZIR':'YOK')}
async function loadSettings(){try{let r=await api('/api/settings');let s=await r.json();for(let k of ['start','end','fps','skip','target','effects'])if(s[k]!=null&&$(k))$(k).value=s[k];if(s.simple!=null)$('simple').checked=s.simple;applyAppearance()}catch(e){}}
async function saveSettings(extra={}){let s={start:$('start').value,end:$('end').value,fps:$('fps').value,skip:$('skip').value,target:$('target').value,effects:$('effects').value,simple:$('simple').checked,...extra};await api('/api/settings',{method:'POST',body:JSON.stringify(s)})}
function applyAppearance(){document.body.classList.toggle('simple',$('simple').checked);document.body.classList.toggle('fx-off',$('effects').value==='Kapalı');document.documentElement.style.setProperty('--glow',$('effects').value==='Güçlü'?'0 0 28px rgba(88,166,255,.5)':$('effects').value==='Hafif'?'0 0 9px rgba(88,166,255,.14)':'0 0 20px rgba(88,166,255,.22)')}async function saveAppearance(){applyAppearance();await saveSettings();alert('Görünüm kaydedildi.')}
async function norm(id){if(!$(id).value.trim())return;try{let r=await api('/api/normalize',{method:'POST',body:JSON.stringify({value:$(id).value})});$(id).value=(await r.json()).value;saveSettings()}catch(e){alert(e.message)}}$('start').onchange=()=>norm('start');$('end').onchange=()=>norm('end');async function pasteCoord(id){try{$(id).value=await navigator.clipboard.readText();await norm(id)}catch(e){alert('Panoya otomatik erişim yoksa kutuya basılı tutup Yapıştır kullan.')}}
async function previewArea(){try{$('preview').innerHTML='Yükleniyor…';let r=await api('/api/preview',{method:'POST',body:JSON.stringify({canvas_id:$('canvas').value,start:$('start').value,end:$('end').value})});let b=await r.blob();$('preview').innerHTML=`<img src="${URL.createObjectURL(b)}">`;updatePreflight()}catch(e){$('preview').innerHTML=`<span style="color:#ff7c86">${e.message}</span>`}}async function downloadSnapshot(){let r=await api('/api/snapshot',{method:'POST',body:JSON.stringify({canvas_id:$('canvas').value,start:$('start').value,end:$('end').value})});let b=await r.blob(),u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download='pixmap_area.png';a.click();URL.revokeObjectURL(u)}
function opts(){return {canvas_id:$('canvas').value,start:$('start').value,end:$('end').value,start_date:$('sd').value,end_date:$('ed').value,frameskip:+$('skip').value,format:$('fmt').value,fps:+$('fps').value,scale:+$('scale').value,speed:+$('speed').value,target_seconds:+$('target').value,quality:$('quality').value,limit:$('limit').value,compat:$('compat').checked,resume:$('resume').checked,compile:true}}async function updatePreflight(){try{let r=await api('/api/preflight',{method:'POST',body:JSON.stringify(opts())}),d=await r.json();$('preflight').textContent=`${d.format.toUpperCase()} • ${d.source[0]}×${d.source[1]} → ${d.output[0]}×${d.output[1]} • Uyumluluk: ${d.compat?'AÇIK':'KAPALI'} • ${d.quality}`}catch(e){$('preflight').textContent='Ön kontrol için koordinatları doğrula.'}}['fmt','scale','limit','quality','compat'].forEach(id=>$(id).onchange=updatePreflight);async function startTimelapse(){try{await norm('start');await norm('end');await saveSettings();await api('/api/timelapse/start',{method:'POST',body:JSON.stringify(opts())});document.querySelector('[data-p=status]').click()}catch(e){alert(e.message)}}async function cancelJob(){await api('/api/cancel',{method:'POST',body:'{}'})}
function rangePreset(x){let f=STATE?.frames||{};if(!f.max)return;let a=f.min,b=f.max;if(x==='a'){a=Math.max(a,1);b=Math.min(b,100)}if(x==='b'){a=Math.max(a,101);b=Math.min(b,200)}if(x==='last')a=Math.max(a,b-99);$('rs').value=a;$('re').value=b}function setRangeFromSlider(x){if(x==='s')$('rs').value=$('slider').value;else $('re').value=$('slider').value}async function loadFrame(n){if(!n)return;$('sliderN').textContent=`t${n}.png`;$('framePreview').innerHTML=`<img src="/api/frame/${n}?sid=${encodeURIComponent(SID)}&x=${Date.now()}">`}let slidTimer;$('slide