<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#090e16"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Pixmap Studio"><link rel="manifest" href="/manifest.webmanifest"><link rel="icon" href="/icon.svg"><title>Pixmap Studio Mobile V9</title><style>
:root{--bg:#070b12;--panel:#101722;--panel2:#171016;--line:#2a3442;--txt:#f7f9fc;--muted:#94a3b4;--blue:#58a6ff;--red:#e30a17;--green:#48d477;--amber:#efb649;--glow:0 0 20px rgba(88,166,255,.22)}*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{margin:0;min-height:100%;font-family:Inter,Segoe UI,system-ui,sans-serif;background:radial-gradient(circle at 50% -10%,#3b0c15 0,#0a1019 34%,#06090e 100%);color:var(--txt)}body{padding-bottom:92px}.fx-off *{animation:none!important;transition:none!important}.simple .fabric,.simple .particles{display:none}.splash{position:fixed;inset:0;z-index:999;background:radial-gradient(circle at 50% 25%,#3b0d15,#080c13 55%,#05080c);display:flex;align-items:center;justify-content:center;transition:.7s opacity}.splash.hide{opacity:0;pointer-events:none}.sbox{width:min(88vw,430px);text-align:center}.sflag{font-size:52px;animation:float 2.8s ease-in-out infinite}.stitle{font-size:25px;font-weight:900;color:#8dcbff;text-shadow:0 0 20px rgba(88,166,255,.45)}.credit{color:white;font-size:12px;margin-top:18px}.checks{text-align:left;margin-top:18px;display:grid;gap:7px}.check{padding:9px 11px;border:1px solid #283342;border-radius:10px;background:#0a1018;color:#9babbc;font-size:12px}.check.ok{color:#78e89b;border-color:#28593a}.check.bad{color:#ff8790;border-color:#6b2a30}.sprogress{height:7px;background:#111923;border-radius:999px;margin-top:14px;overflow:hidden}.sprogress i{display:block;height:100%;width:0;background:linear-gradient(90deg,#e30a17,#fff,#58a6ff);transition:width .35s}header{position:sticky;top:0;z-index:30;padding:calc(env(safe-area-inset-top) + 8px) 12px 8px;background:rgba(7,11,18,.94);backdrop-filter:blur(17px);border-bottom:1px solid #27313e}.brand{display:flex;align-items:center;gap:11px;min-height:64px}.logo{width:76px;height:46px;filter:drop-shadow(0 0 13px rgba(227,10,23,.25));animation:float 3s ease-in-out infinite}.brand h1{font-size:18px;line-height:1.05;margin:0;color:#78bdff}.brand small{display:block;margin-top:5px;color:#8798aa;letter-spacing:.8px}.topdot{margin-left:auto;width:10px;height:10px;border-radius:50%;background:#48d477;box-shadow:0 0 12px #48d477;animation:pulse 1.5s infinite}@keyframes float{50%{transform:translateY(-2px)}}@keyframes pulse{50%{opacity:.42}}main{padding:12px;max-width:860px;margin:auto}.page{display:none}.page.active{display:block}.card{position:relative;overflow:hidden;margin-bottom:12px;padding:14px;border:1px solid #2b3543;border-radius:17px;background:linear-gradient(180deg,rgba(18,26,38,.97),rgba(11,17,25,.97));box-shadow:0 13px 30px rgba(0,0,0,.24)}.fabric{position:absolute;inset:auto -80px -120px auto;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,#c70b18 0,rgba(199,11,24,.12) 42%,transparent 70%);filter:blur(3px);pointer-events:none}.card h3{margin:0 0 11px;font-size:14px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:9px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.row{display:flex;gap:8px}.row>*{flex:1}label{display:block;font-size:11px;color:var(--muted);margin:0 0 5px}input,select{width:100%;height:47px;border:1px solid #374457;border-radius:11px;background:#090f17;color:#fff;padding:0 11px;font-size:14px;outline:none}input:focus,select:focus{border-color:#8bcaff;box-shadow:0 0 0 2px rgba(88,166,255,.16)}button,.btn{height:48px;border-radius:11px;border:1px solid #4a596c;background:#182433;color:#fff;font-weight:750;font-size:13px;padding:0 12px;transition:.16s;display:flex;align-items:center;justify-content:center;text-decoration:none}button:active,.btn:active{transform:scale(.98);box-shadow:0 0 0 2px #fff}.primary{background:linear-gradient(180deg,#3185e8,#1e66c5);border-color:#74baff;box-shadow:var(--glow)}.danger{background:linear-gradient(180deg,#df2d3a,#9e0b15);border-color:#ff7580}.success{background:linear-gradient(180deg,#2e9d58,#1d6f3d);border-color:#67df8f}.hint{font-size:11px;line-height:1.45;color:#8190a2;margin-top:7px}.pill{display:inline-flex;align-items:center;gap:6px;border:1px solid #344154;border-radius:999px;background:#081019;padding:7px 9px;font-size:10px;color:#c2cedb}.preview{min-height:190px;border:1px solid #2f3b4c;border-radius:13px;background:#05080d;display:flex;align-items:center;justify-content:center;overflow:hidden}.preview img{max-width:100%;max-height:57vh}.metric{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.metric div{background:#081019;border:1px solid #273345;border-radius:11px;text-align:center;padding:9px}.metric strong{display:block;font-size:15px}.metric span{font-size:9px;color:#8797a8}.progress{height:10px;background:#060a0f;border:1px solid #273344;border-radius:999px;overflow:hidden}.progress i{display:block;width:0;height:100%;background:linear-gradient(90deg,#e30a17,#fff,#58a6ff);transition:.3s}.logs{background:#05090e;border:1px solid #263244;border-radius:11px;min-height:110px;max-height:220px;overflow:auto;white-space:pre-wrap;padding:10px;font:11px/1.45 Consolas,monospace;color:#c9d8ea}.tabs{position:fixed;left:0;right:0;bottom:0;z-index:40;display:grid;grid-template-columns:repeat(5,1fr);gap:5px;padding:7px 7px calc(7px + env(safe-area-inset-bottom));background:rgba(5,9,14,.95);backdrop-filter:blur(18px);border-top:1px solid #252f3d}.tab{height:60px;border-radius:12px;background:#101823;border-color:#263243;color:#9cabbc;font-size:10px;padding:5px}.tab b{display:block;font-size:18px;color:#eef5fd}.tab.active{background:#17293d;border-color:#64b2ff}.rbtns{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:8px}.rbtns button{height:39px;font-size:10px;padding:0 4px}.slider{width:100%}.rangeRead{display:flex;justify-content:space-between;color:#9cabbc;font-size:11px;margin-top:4px}.statusline{display:flex;gap:7px;flex-wrap:wrap}.outlist{display:grid;gap:7px}.outitem{padding:9px;border:1px solid #293647;border-radius:10px;background:#081019}.outitem a{color:#79bfff;text-decoration:none;font-size:12px}.switchline{display:flex;align-items:center;justify-content:space-between;gap:12px}.switchline input{width:22px;height:22px}.rangeimage{min-height:160px}.installBanner{display:none;padding:10px;margin-bottom:12px;border:1px solid #5e85ac;border-radius:13px;background:#11253a}.installBanner.show{display:flex;gap:8px;align-items:center}.installBanner button{margin-left:auto;height:38px}.flash-ok{animation:okflash .9s}@keyframes okflash{50%{box-shadow:0 0 35px rgba(72,212,119,.75);border-color:#5be889}}.flash-bad{animation:badflash .9s}@keyframes badflash{50%{box-shadow:0 0 35px rgba(240,70,80,.7