            cxs=max(0,(x1+center)//CHUNK_PX);cys=max(0,(y1+center)//CHUNK_PX);cxe=min(chunks-1,(x2+center)//CHUNK_PX);cye=min(chunks-1,(y2+center)//CHUNK_PX)
            if not resume:
                for p in st.frames_dir.glob("t*.png"):
                    try:p.unlink()
                    except OSError:pass
            sess=make_session();curr=sd;days=(ed-sd).days+1;frame_cnt=0;previous=None;reused=0;repaired=0
            def hist(job):
                cx,cy,day,hhmm=job;return cx,cy,fetch_raw(f"{PIXMAP_URL}/history/chunk/{cid}/{day}/{hhmm}/{cx}_{cy}.png",sess,8)
            while curr<=ed:
                if st.job.get("cancel"): raise RuntimeError("İşlem iptal edildi.")
                di=(curr-sd).days;day=curr.strftime("%Y%m%d");st.log(f"{day}: snapshot listesi alınıyor…")
                raw=fetch_raw(f"{PIXMAP_URL}/history/snapshots/{cid}?day={day}",sess,8);snaps=[]
                if raw:
