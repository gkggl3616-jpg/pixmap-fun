force_original_aspect_ratio=decrease")
    if ext=="mp4": filters.append("pad=ceil(iw/2)*2:ceil(ih/2)*2")
    if preview:
        filters.append("scale='min(1280,iw)':-2:force_original_aspect_ratio=decrease")
    if filters: cmd += ["-vf",",".join(filters)]
    if ext=="mp4":
        cmd += ["-c:v","libx264","-preset","veryfast" if preview else quality["preset"],"-crf","28" if preview else quality["crf"],"-pix_fmt","yuv420p"]
        if compat: cmd += ["-movflags","+faststart","-tag:v","avc1"]
        cmd += [str(out)]
    elif ext=="webm":
        if "lossless" in fmt: cmd += ["-c:v","libvpx-vp9","-lossless","1","-pix_fmt","yuv444p",str(out)]
        else: cmd += ["-c:v","libvpx-vp9","-crf","32" if preview else "28","-b:v","0",str(out)]
    else:
        cmd += [str(out)]
    st.log("FFmpeg: "+" ".join(cmd))
    proc=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,errors="replace")
    for line in proc.stdout or []:
        if st.job.get("cancel"):
            proc.terminate();raise RuntimeError("İşlem iptal edildi.")
        if "frame=" in line or "time=" in line: st.set_job(status="Video oluşturuluyor…")
    proc.wait()
    if proc.returncode!=0: raise RuntimeError(f"FFmpeg hata kodu: {proc.returncode}")
    verify=media_verify(out,fmt)
    if not verify["ok"]: raise RuntimeError("Video doğrulanamadı: "+verify["detail"])
    st.log("Doğrulama: "+verify["detail"])
    return out,fps,verify


def run_compile(st,payload,preview=False):
    if st.job.get("running"): raise RuntimeError("Başka bir işlem zaten çalışıyor.")
    health=st.frame_health()
    if not health["count"]: raise RuntimeError("Kare bulunamadı.")
    s=int(payload.get("start_frame",health["min"]));e=int(payload.get("end_frame",health["max"]))
    st.set_job(running=True,cancel=False,kind="preview" if preview else "compile",progress=5,status="Kareler hazırlanıyor…",logs=[],output=None,ok=None)
    def worker():
        try:
            out,fps,verify=compile_range(st,s,e,payload,preview=preview)
            st.log(f"Çıktı hazır: {out.name} • {fps:.2f} FPS")
            st.set_job(running=False,progress=100,status="Önizleme hazır ✓" if preview else "Video hazır ✓",output=out.name,frames=e-s+1,ok=True)
        except Exception as ex:
            st.log("HATA: "+str(ex));st.set_job(running=False,progress=0,status="Hata: "+str(ex),ok=False)
    threading.Thread(target=worker,daemon=True).start()


def run_timelapse(st,payload):
    if st.job.get("running"): raise RuntimeError("Başka bir işlem zaten çalışıyor.")
    cid=str(payload.get("canvas_id","0"));canvas=GLOBAL["canvases"].get(cid)
    if not canvas: raise ValueError("Tuval bulunamadı.")
    coords=parse_coords(payload.get("start",""),payload.get("end",""),canvas)
    sd=datetime.date.fromisoformat(payload["start_date"]);ed=datetime.date.fromisoformat(payload["end_date"])
    if sd>ed: raise ValueError("Başlangıç tarihi bitiş tarihinden sonra olamaz.")
    frameskip=max(1,int(payload.get("frameskip",1)));resume=bool(payload.get("resume",True));compile_video=bool(payload.get("compile",True))
    signature={"canvas_id":cid,"coords":coords,"start_date":str(sd),"end_date":str(ed),"frameskip":frameskip}
    st.save_settings({"last_timelapse":signature})
    st.set_job(running=True,cancel=False,kind="timelapse",progress=0,status="Timelapse hazırlanıyor…",logs=[],output=None,frames=0,ok=None)
    def worker():
        sess=None
