                            except Exception: pass
                if base.getcolors(1) is not None and previous is not None: base=previous.copy()
                frame_cnt+=1;fp=st.frames_dir/f"t{frame_cnt}.png"
                healthy=False
                if resume and fp.is_file():
                    try:
                        with Image.open(fp) as im: im.verify();healthy=True
                    except Exception: repaired+=1
                if healthy: reused+=1
                else: base.save(fp)
                diffs=[x for x in snaps if x!="0000"];last=base
